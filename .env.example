# SimpleBrain — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.
#
# Usage:
#   cp .env.example .env
#   python -m simplebrain --setup

# ---------------------------------------------------------------------------
# Brain Storage
# ---------------------------------------------------------------------------

# Root directory where all brain data is stored (folders, queue, raw files).
# Defaults to ~/simplebrain if not set.
BRAIN_ROOT=~/simplebrain

# Your username — written into every knowledge chunk's frontmatter.
BRAIN_USER=default

# Device label — useful if you use SimpleBrain from multiple machines.
BRAIN_DEVICE=mac

# How often the self-healer runs to detect conflicts and inconsistencies.
# Options: daily | weekly | manual
# If not set, this is also inferred by the LLM during setup.
BRAIN_HEALER_SCHEDULE=daily

# ---------------------------------------------------------------------------
# LLM Provider
# Set LLM_PROVIDER to one of the supported values, then fill in the
# corresponding section below. Leave other sections empty.
# ---------------------------------------------------------------------------

# Supported providers: openai | anthropic | ollama | lmstudio | cohere | groq | gemini
LLM_PROVIDER=openai

# Model name. LiteLLM provider prefixes (ollama/, lm_studio/) are added
# automatically if needed — just use the bare model name here.
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# OpenAI  (LLM_PROVIDER=openai)
# ---------------------------------------------------------------------------

OPENAI_API_KEY=

# Optional: override the API base (e.g. for Azure or a proxy)
# LLM_API_BASE=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Anthropic  (LLM_PROVIDER=anthropic)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# LLM_MODEL=claude-3-5-haiku-20241022

# ---------------------------------------------------------------------------
# Ollama  (LLM_PROVIDER=ollama)  — no API key needed
# ---------------------------------------------------------------------------

# LLM_MODEL=llama3.2
# LLM_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# LM Studio  (LLM_PROVIDER=lmstudio)  — no API key needed
# ---------------------------------------------------------------------------

# LLM_MODEL=google/gemma-4-e2b
# LLM_API_BASE=http://localhost:1234/v1

# ---------------------------------------------------------------------------
# Groq  (LLM_PROVIDER=groq)
# ---------------------------------------------------------------------------

GROQ_API_KEY=

# LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Google Gemini  (LLM_PROVIDER=gemini)
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

# LLM_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Generic override (takes precedence over provider-specific vars above)
# Use these to explicitly set any provider's base URL or API key.
# ---------------------------------------------------------------------------

# LLM_API_BASE=
# LLM_API_KEY=
