# SimpleBrain — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.
#
# Usage (local):
#   cp .env.example .env
#   python -m simplebrain --setup
#
# Usage (Docker — one command):
#   cp .env.example .env   # then edit .env
#   docker compose up -d

# ---------------------------------------------------------------------------
# Brain Storage
# ---------------------------------------------------------------------------

# Root directory where all brain data is stored (folders, queue, raw files).
# Defaults to ~/simplebrain if not set.
BRAIN_ROOT=~/simplebrain

# Your username — written into every knowledge chunk's frontmatter.
BRAIN_USER=default

# Device label — useful if you use SimpleBrain from multiple machines.
BRAIN_DEVICE=mac

# How often the self-healer runs to detect conflicts and inconsistencies.
# Options: daily | weekly | manual
# If not set, the LLM will infer this during setup from your description.
BRAIN_HEALER_SCHEDULE=daily

# Max seconds to wait for a single LLM response. Prevents the worker from
# hanging indefinitely when LM Studio is busy or the WiFi drops.
# Default: 120 seconds.
LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log level for stderr output. The log file always captures DEBUG.
# Options: DEBUG | INFO | WARNING | ERROR
BRAIN_LOG_LEVEL=INFO

# Set to 0 to suppress LLM prompts and raw responses from the log file.
# Useful to reduce log size in production.
BRAIN_LOG_LLM=1

# ---------------------------------------------------------------------------
# Whisper (voice transcription)
# ---------------------------------------------------------------------------

# Device for faster-whisper inference.
# Options: cpu | cuda | auto | mps (Apple Silicon)
# Default is cpu (works everywhere). Use mps on Apple Silicon, cuda on NVIDIA.
WHISPER_DEVICE=cpu

# Quantisation / compute type.
# int8 is fastest on CPU. float16 requires GPU.
WHISPER_COMPUTE=int8

# ---------------------------------------------------------------------------
# LLM Provider
#
# Supported providers:
#   openai      — OpenAI API (GPT-4o, GPT-4o-mini, etc.)
#   anthropic   — Anthropic API (Claude)
#   ollama      — Local Ollama server (no key needed)
#   lmstudio    — Local LM Studio server (no key needed)
#   groq        — Groq cloud inference API
#   gemini      — Google Gemini API
#   cohere      — Cohere API
#
# Set LLM_PROVIDER, LLM_MODEL, and fill in the matching section below.
# ---------------------------------------------------------------------------

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# LM Studio  (LLM_PROVIDER=lmstudio)
# No API key needed. Start LM Studio and load a model before running.
# ---------------------------------------------------------------------------

# LLM_PROVIDER=lmstudio
# LLM_MODEL=google/gemma-4-e2b
# LLM_API_BASE=http://localhost:1234/v1

# ---------------------------------------------------------------------------
# Ollama  (LLM_PROVIDER=ollama)
# No API key needed. Run: ollama pull llama3.2
# ---------------------------------------------------------------------------

# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# OpenAI  (LLM_PROVIDER=openai)
# ---------------------------------------------------------------------------

OPENAI_API_KEY=

# Optional: override the API base (e.g. for Azure or a proxy)
# LLM_API_BASE=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Anthropic  (LLM_PROVIDER=anthropic)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-20241022

# ---------------------------------------------------------------------------
# Groq  (LLM_PROVIDER=groq)
# ---------------------------------------------------------------------------

GROQ_API_KEY=

# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Google Gemini  (LLM_PROVIDER=gemini)
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Cohere  (LLM_PROVIDER=cohere)
# ---------------------------------------------------------------------------

COHERE_API_KEY=

# LLM_PROVIDER=cohere
# LLM_MODEL=command-r-plus

# ---------------------------------------------------------------------------
# Generic overrides — take precedence over all provider-specific vars above.
# Use when pointing at a proxy, custom endpoint, or non-standard deployment.
# ---------------------------------------------------------------------------

# LLM_API_BASE=
# LLM_API_KEY=
